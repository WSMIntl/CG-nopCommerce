@using static Nop.Services.Common.NopLinksDefaults
@{
    Layout = "";
}

@using Microsoft.AspNetCore.Http
@using Nop.Core
@using Nop.Core.Domain.Customers
@using Nop.Data
@using Nop.Services.Customers
@using Nop.Web.Framework
@using Nop.Services.Directory

@inject IHttpContextAccessor _httpContextAccessor
@inject ICustomerService _customerService
@inject IWorkContext _webWorkContext
@inject IGeoLookupService _geoLookupService
@{
    Customer _customer = await _webWorkContext.GetCurrentCustomerAsync();
    int[] customerRoleIds = await _customerService.GetCustomerRoleIdsAsync(_customer);

    string _roles = "";
    foreach (int customerRoleId in customerRoleIds)
    {
        if (!string.IsNullOrEmpty(_roles)) _roles += ", ";
        _roles += (await _customerService.GetCustomerRoleByIdAsync(customerRoleId))?.Name;
    }

    string CF_IP = _httpContextAccessor.HttpContext.Request.Headers["CF-Connecting-IP"];
    string F_IP = _httpContextAccessor.HttpContext.Request.Headers["X-FORWARDED-FOR"];
    string cf_ip = _httpContextAccessor.HttpContext.Request.Headers["cf-connecting-ip"];
    string f_ip = _httpContextAccessor.HttpContext.Request.Headers["x-forwarded-for"];
    string r_ip = _httpContextAccessor.HttpContext.Connection.RemoteIpAddress?.ToString();
    string ip = !string.IsNullOrWhiteSpace(CF_IP) ? CF_IP :
        !string.IsNullOrWhiteSpace(F_IP) ? F_IP :
        !string.IsNullOrWhiteSpace(cf_ip) ? cf_ip :
        !string.IsNullOrWhiteSpace(f_ip) ? f_ip : r_ip;
    string stored_ip = _customer.LastIpAddress;
    string forwarded_country = string.IsNullOrWhiteSpace(ip) ? "" : _geoLookupService.LookupCountryIsoCode(ip);
    string remote_country = string.IsNullOrWhiteSpace(r_ip) ? "" : _geoLookupService.LookupCountryIsoCode(r_ip);
    string stored_country = string.IsNullOrWhiteSpace(stored_ip) ? "" : _geoLookupService.LookupCountryIsoCode(stored_ip);
    bool stored_ip_present = !string.IsNullOrWhiteSpace(stored_ip);
    bool stored_ip_matches_remote = stored_ip_present && string.Equals(stored_ip, r_ip, StringComparison.OrdinalIgnoreCase);
}

